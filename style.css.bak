/* ==========================================================================
   HARSHITHA SURESH — BESPOKE CREATIVE DEVELOPER & DESIGNER PORTFOLIO
   Strict Classic Palette:
   - Ivory:    #F7F3EB (Warm, continuous editorial canvas)
   - Burgundy: #7D263A (Regal, deep luxury accent)
   - Charcoal: #25221F (Warm espresso anchor typography)
   Aesthetic Influences:
   - Tim Quirino (Minimalist atmospheric hero, particle space, precision cursor)
   - Meet Vora (Preloader, tactile orbit wheel, playful magnetic contact)
   - Zhenya Rynzhuk (Color collision tab/page transitions)
   - Thibaut Crépelle (Tactile mechanical keyboard console)
   ========================================================================== */

@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700;800&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap');

:root {
  /* Strict User Palette */
  --color-ivory: #F7F3EB;
  --color-burgundy: #7D263A;
  --color-charcoal: #25221F;

  /* Harmonious Tonal Extensions (Warm & Organic) */
  --color-ivory-surface: #F2ECE1;
  --color-ivory-card: #FAF8F4;
  --color-ivory-warm: #EBE4D6;
  --color-ivory-border: #E0D7C5;
  --color-burgundy-dark: #581625;
  --color-burgundy-light: #962E45;
  --color-burgundy-soft: rgba(125, 38, 58, 0.08);
  --color-burgundy-glow: rgba(125, 38, 58, 0.18);
  --color-charcoal-muted: #56504B;
  --color-charcoal-light: #827A73;
  --color-charcoal-soft: rgba(37, 34, 31, 0.04);
  --color-border: rgba(37, 34, 31, 0.09);
  --color-border-burgundy: rgba(125, 38, 58, 0.22);

  /* Typography */
  --font-serif: 'Playfair Display', Georgia, serif;
  --font-display: 'Cinzel', serif;
  --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
  --font-mono: 'Space Mono', monospace;

  /* Layout & Transitions */
  --container-max: 1360px;
  --ease-out-expo: cubic-bezier(0.16, 1, 0.3, 1);
  --radius-sm: 6px;
  --radius-md: 14px;
  --radius-lg: 24px;
  --radius-full: 9999px;
}

/* ==========================================================================
   Base & Reset
   ========================================================================== */
*, *::before, *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  font-size: 16px;
  background-color: var(--color-ivory);
  color: var(--color-charcoal);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

body {
  font-family: var(--font-sans);
  background-color: var(--color-ivory);
  color: var(--color-charcoal);
  line-height: 1.65;
  overflow-x: hidden;
  position: relative;
  min-height: 100vh;
}

::selection {
  background: var(--color-burgundy);
  color: var(--color-ivory);
}

a {
  color: inherit;
  text-decoration: none;
}

button {
  font-family: inherit;
  border: none;
  background: none;
  cursor: pointer;
}

img {
  max-width: 100%;
  height: auto;
  display: block;
}

/* ==========================================================================
   Custom Cursors (Tim Quirino on Hero, Meet Vora on All Other Sections)
   ========================================================================== */
@media (hover: hover) and (pointer: fine) {
  body {
    cursor: none;
  }
  a, button, input, textarea, [data-magnetic] {
    cursor: none;
  }
}

.cursor-dot {
  position: fixed;
  top: 0;
  left: 0;
  width: 7px;
  height: 7px;
  background-color: var(--color-burgundy);
  border-radius: 50%;
  pointer-events: none;
  z-index: 9999;
  transform: translate(-50%, -50%);
  transition: transform 0.06s ease-out, opacity 0.2s ease, width 0.3s ease, height 0.3s ease;
}

.cursor-follower {
  position: fixed;
  top: 0;
  left: 0;
  width: 34px;
  height: 34px;
  border: 1.5px solid var(--color-burgundy);
  border-radius: 50%;
  pointer-events: none;
  z-index: 9998;
  transform: translate(-50%, -50%);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.16s var(--ease-out-expo), width 0.35s var(--ease-out-expo), height 0.35s var(--ease-out-expo), background-color 0.3s ease, border-color 0.3s ease;
}

.cursor-text {
  font-family: var(--font-mono);
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-ivory);
  opacity: 0;
  transform: scale(0.6);
  transition: opacity 0.2s ease, transform 0.2s ease;
  pointer-events: none;
}

.cursor-follower.cursor-meetvora {
  width: 68px;
  height: 68px;
  background-color: var(--color-burgundy);
  border-color: var(--color-burgundy);
  box-shadow: 0 8px 24px var(--color-burgundy-glow);
}

.cursor-follower.cursor-meetvora .cursor-text {
  opacity: 1;
  transform: scale(1);
}

.cursor-follower.cursor-meetvora-charcoal {
  background-color: var(--color-charcoal);
  border-color: var(--color-charcoal);
}

/* ==========================================================================
   Meet Vora Preloader (0-100% + Kinetic Typography in Warm Ivory)
   ========================================================================== */
#preloader {
  position: fixed;
  inset: 0;
  z-index: 10000;
  background-color: var(--color-ivory);
  color: var(--color-charcoal);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 3rem 4rem;
  overflow: hidden;
}

.preloader-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-family: var(--font-mono);
  font-size: 0.82rem;
  letter-spacing: 0.12em;
  color: var(--color-ivory);
  opacity: 0.85;
}

.preloader-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.preloader-kinetic-text {
  font-family: var(--font-serif);
  font-size: clamp(2.2rem, 5.5vw, 4.8rem);
  font-weight: 600;
  line-height: 1.2;
  letter-spacing: -0.02em;
  color: var(--color-charcoal);
  margin-bottom: 2rem;
}

.preloader-kinetic-text span {
  display: inline-block;
  color: var(--color-burgundy);
  font-style: italic;
}

.preloader-track {
  width: min(380px, 80vw);
  height: 3px;
  background-color: rgba(37, 34, 31, 0.1);
  position: relative;
  overflow: hidden;
  border-radius: var(--radius-full);
}

.preloader-bar {
  position: absolute;
  top: 0;
  left: 0;
  height: 100%;
  width: 0%;
  background-color: var(--color-burgundy);
  border-radius: var(--radius-full);
  transition: width 0.1s linear;
}

.preloader-footer {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.preloader-counter {
  font-family: var(--font-mono);
  font-size: clamp(3rem, 10vw, 7.5rem);
  font-weight: 700;
  line-height: 0.9;
  color: var(--color-charcoal);
  letter-spacing: -0.03em;
}

.preloader-counter span {
  font-size: 0.4em;
  color: var(--color-burgundy);
  margin-left: 0.2rem;
}

.preloader-motto {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--color-charcoal-muted);
  opacity: 0.8;
}

/* ==========================================================================
   Zhenya Rynzhuk Color Collision Transition Overlay (Pure Color Shapes)
   ========================================================================== */
#collision-overlay {
  position: fixed;
  inset: 0;
  z-index: 9990;
  pointer-events: none;
  display: none;
  align-items: center;
  justify-content: center;
  background: transparent;
  overflow: hidden;
}

.collision-veil {
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, var(--color-burgundy) 0%, var(--color-charcoal) 100%);
  opacity: 0;
}

.collision-sphere {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
  box-shadow: 0 15px 45px rgba(0, 0, 0, 0.25);
}

.sphere-burgundy {
  width: 150px;
  height: 150px;
  background-color: var(--color-burgundy);
  left: -200px;
}

.sphere-charcoal {
  width: 150px;
  height: 150px;
  background-color: var(--color-ivory);
  right: -200px;
}

/* ==========================================================================
   Global Header & Navigation
   ========================================================================== */
.site-header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  padding: 1.4rem 3.5rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  z-index: 1000;
  background: rgba(247, 243, 235, 0.92);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border-bottom: 1px solid var(--color-border);
  transition: padding 0.3s ease, background 0.3s ease;
}

.brand-monogram {
  display: flex;
  align-items: center;
  gap: 0.85rem;
}

.monogram-badge {
  width: 38px;
  height: 38px;
  background-color: var(--color-burgundy);
  color: var(--color-ivory);
  border-radius: var(--radius-sm);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-display);
  font-size: 1.05rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  box-shadow: 0 4px 12px var(--color-burgundy-soft);
  transition: transform 0.3s var(--ease-out-expo);
}

.monogram-badge:hover, .monogram-badge-img:hover {
  transform: scale(1.08) rotate(-3deg);
}

.monogram-badge-img {
  width: 38px;
  height: 38px;
  border-radius: 8px;
  display: block;
  box-shadow: 0 4px 12px var(--color-burgundy-soft);
  transition: transform 0.3s var(--ease-out-expo);
}

.brand-info {
  display: flex;
  flex-direction: column;
}

.brand-name {
  font-family: var(--font-serif);
  font-weight: 700;
  font-size: 1.05rem;
  letter-spacing: -0.01em;
  color: var(--color-charcoal);
}

.brand-title {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-burgundy);
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 2.2rem;
  list-style: none;
}

.nav-link {
  font-family: var(--font-sans);
  font-size: 0.88rem;
  font-weight: 500;
  color: var(--color-charcoal-muted);
  position: relative;
  padding: 0.4rem 0.2rem;
  transition: color 0.25s ease;
}

.nav-link::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0%;
  height: 2px;
  background-color: var(--color-burgundy);
  transition: width 0.3s var(--ease-out-expo);
}

.nav-link:hover, .nav-link.active {
  color: var(--color-burgundy);
}

.nav-link:hover::after, .nav-link.active::after {
  width: 100%;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 1.2rem;
}

.audio-toggle-btn {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.45rem 0.9rem;
  background-color: var(--color-ivory-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-full);
  font-family: var(--font-mono);
  font-size: 0.72rem;
  font-weight: 600;
  color: var(--color-charcoal);
  letter-spacing: 0.08em;
  transition: all 0.25s ease;
}

.audio-toggle-btn:hover {
  border-color: var(--color-burgundy);
  color: var(--color-burgundy);
}

.audio-wave {
  display: inline-flex;
  align-items: center;
  gap: 2px;
  height: 12px;
}

.audio-bar {
  width: 2px;
  height: 4px;
  background-color: var(--color-burgundy);
  border-radius: 1px;
}

.audio-toggle-btn.playing .audio-bar:nth-child(1) { animation: wave 0.8s ease infinite alternate; }
.audio-toggle-btn.playing .audio-bar:nth-child(2) { animation: wave 0.8s ease 0.2s infinite alternate; }
.audio-toggle-btn.playing .audio-bar:nth-child(3) { animation: wave 0.8s ease 0.4s infinite alternate; }

@keyframes wave {
  0% { height: 3px; }
  100% { height: 12px; }
}

.btn-contact-nav {
  padding: 0.55rem 1.4rem;
  background-color: var(--color-burgundy);
  color: var(--color-ivory);
  font-family: var(--font-sans);
  font-size: 0.82rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  border-radius: var(--radius-full);
  box-shadow: 0 4px 14px var(--color-burgundy-soft);
  transition: all 0.3s var(--ease-out-expo);
}

.btn-contact-nav:hover {
  background-color: var(--color-burgundy-dark);
  transform: translateY(-2px);
  box-shadow: 0 8px 20px var(--color-burgundy-glow);
}

/* ==========================================================================
   SECTION 1: HERO (Tim Quirino Inspired)
   Atmospheric interactive particle space, clean editorial typography,
   "Harshitha Suresh", "Design.Create.Innovate", no cluttered labels
   ========================================================================== */
.hero-section {
  position: relative;
  min-height: 100vh;
  padding: 10rem 4rem 4rem 4rem;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  background-color: var(--color-ivory);
  border-bottom: 1px solid var(--color-border);
  overflow: hidden;
}

/* Interactive Canvas Particle Space (Tim Quirino Arrakis/Spice Atmosphere) */
#hero-particles-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 1;
  opacity: 0.7;
}

.hero-content-wrap {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: calc(100vh - 14rem);
}

.hero-meta-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-family: var(--font-mono);
  font-size: 0.8rem;
  letter-spacing: 0.1em;
  color: var(--color-charcoal-muted);
  border-bottom: 1px solid var(--color-border);
  padding-bottom: 1.2rem;
  margin-bottom: 2rem;
}

.hero-location {
  display: flex;
  align-items: center;
  gap: 0.6rem;
}

.pulse-dot {
  width: 8px;
  height: 8px;
  background-color: #2e8b57;
  border-radius: 50%;
  box-shadow: 0 0 0 0 rgba(46, 139, 87, 0.7);
  animation: pulseGreen 2s infinite;
}

@keyframes pulseGreen {
  0% { box-shadow: 0 0 0 0 rgba(46, 139, 87, 0.7); }
  70% { box-shadow: 0 0 0 8px rgba(46, 139, 87, 0); }
  100% { box-shadow: 0 0 0 0 rgba(46, 139, 87, 0); }
}

.hero-center-typography {
  margin: auto 0;
  padding: 3rem 0;
}

.hero-title-main {
  font-family: var(--font-serif);
  font-size: clamp(2.8rem, 7.8vw, 7.4rem);
  font-weight: 700;
  line-height: 0.98;
  letter-spacing: -0.035em;
  color: var(--color-charcoal);
  margin-left: -0.04em;
}

.hero-title-main .italic-accent {
  font-style: italic;
  font-weight: 400;
  color: var(--color-burgundy);
}

.hero-tagline-motto {
  font-family: var(--font-display);
  font-size: clamp(1.1rem, 2.2vw, 2.1rem);
  font-weight: 600;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--color-charcoal-muted);
  margin-top: 1.4rem;
}

.hero-tagline-motto span {
  color: var(--color-burgundy);
}

.hero-statement-grid {
  display: grid;
  grid-template-columns: 1.3fr 1fr;
  gap: 4rem;
  align-items: flex-end;
  padding-top: 2rem;
  border-top: 1px solid var(--color-border);
}

.hero-lead-text {
  font-family: var(--font-sans);
  font-size: clamp(1.1rem, 1.4vw, 1.35rem);
  font-weight: 400;
  line-height: 1.7;
  color: var(--color-charcoal);
}

.hero-lead-text strong {
  color: var(--color-burgundy);
  font-weight: 600;
}

.hero-stats-strip {
  display: flex;
  gap: 3rem;
  justify-content: flex-end;
}

.stat-item {
  display: flex;
  flex-direction: column;
}

.stat-val {
  font-family: var(--font-serif);
  font-size: 2.4rem;
  font-weight: 700;
  color: var(--color-burgundy);
  line-height: 1.1;
}

.stat-label {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--color-charcoal-muted);
  margin-top: 0.3rem;
}

/* Running Ticker Ribbon */
.hero-ticker-wrap {
  width: 100vw;
  margin-left: -4rem;
  overflow: hidden;
  background-color: var(--color-charcoal);
  color: var(--color-ivory);
  padding: 0.85rem 0;
  margin-top: 3rem;
}

.hero-ticker {
  display: flex;
  white-space: nowrap;
  gap: 3rem;
  animation: marquee 24s linear infinite;
}

.ticker-item {
  font-family: var(--font-mono);
  font-size: 0.82rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  display: flex;
  align-items: center;
  gap: 1.5rem;
}

.ticker-bullet {
  color: var(--color-burgundy-light);
}

@keyframes marquee {
  0% { transform: translateX(0%); }
  100% { transform: translateX(-50%); }
}

/* ==========================================================================
   Section Headers & Container Layout
   ========================================================================== */
.section-container {
  max-width: var(--container-max);
  margin: 0 auto;
  padding: 7rem 2.5rem;
}

.section-editorial-header {
  margin-bottom: 3.8rem;
  position: relative;
}

.section-label {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--color-burgundy);
  display: flex;
  align-items: center;
  gap: 0.8rem;
  margin-bottom: 0.8rem;
}

.section-label::before {
  content: '§';
  font-family: var(--font-serif);
  font-size: 1.1rem;
}

.section-title {
  font-family: var(--font-serif);
  font-size: clamp(2.4rem, 4.8vw, 4.2rem);
  font-weight: 700;
  line-height: 1.05;
  letter-spacing: -0.025em;
  color: var(--color-charcoal);
}

.section-title span {
  font-style: italic;
  font-weight: 400;
  color: var(--color-burgundy);
}

.section-subhead {
  font-family: var(--font-sans);
  font-size: 1.05rem;
  color: var(--color-charcoal-muted);
  max-width: 680px;
  margin-top: 0.8rem;
}

/* ==========================================================================
   SECTION 2: ABOUT ME (Meet Vora Style)
   Warm organic cards, no harsh white glare
   ========================================================================== */
.about-section {
  background-color: var(--color-ivory-surface);
  border-bottom: 1px solid var(--color-border);
}

.about-grid {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: 4rem;
  align-items: flex-start;
}

.about-narrative-card {
  background: var(--color-ivory-card);
  border: 1px solid var(--color-ivory-border);
  border-radius: var(--radius-lg);
  padding: 3.2rem;
  box-shadow: 0 15px 40px rgba(37, 34, 31, 0.04);
}

.author-header-badge {
  display: flex;
  align-items: center;
  gap: 1.2rem;
  margin-bottom: 2rem;
  padding-bottom: 1.8rem;
  border-bottom: 1px solid var(--color-border);
}

.author-avatar-seal {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--color-burgundy), var(--color-charcoal));
  color: var(--color-ivory);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-display);
  font-size: 1.4rem;
  font-weight: 800;
  box-shadow: 0 6px 20px var(--color-burgundy-glow);
}

.author-title-group h3 {
  font-family: var(--font-serif);
  font-size: 1.8rem;
  color: var(--color-charcoal);
  letter-spacing: -0.01em;
}

.author-title-group p {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  letter-spacing: 0.1em;
  color: var(--color-burgundy);
  text-transform: uppercase;
}

.about-bio-text {
  font-family: var(--font-sans);
  font-size: 1.05rem;
  line-height: 1.8;
  color: var(--color-charcoal);
  margin-bottom: 1.5rem;
}

.about-bio-text strong {
  color: var(--color-burgundy);
  font-weight: 600;
}

.about-bio-quote {
  padding: 1.2rem 1.6rem;
  background-color: var(--color-ivory-warm);
  border-left: 3px solid var(--color-burgundy);
  font-family: var(--font-serif);
  font-style: italic;
  font-size: 1.15rem;
  color: var(--color-charcoal);
  border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
  margin: 1.8rem 0;
}

.polyglot-block {
  margin-top: 2rem;
  padding-top: 1.6rem;
  border-top: 1px solid var(--color-border);
}

.polyglot-title {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--color-charcoal-muted);
  margin-bottom: 1rem;
}

.polyglot-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
}

.lang-pill {
  padding: 0.45rem 1rem;
  background-color: var(--color-ivory);
  border: 1px solid var(--color-ivory-border);
  border-radius: var(--radius-full);
  font-family: var(--font-sans);
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--color-charcoal);
  transition: all 0.25s ease;
}

.lang-pill:hover {
  background-color: var(--color-burgundy);
  color: var(--color-ivory);
  border-color: var(--color-burgundy);
  transform: translateY(-2px);
}

.about-sidebar-column {
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

.sidebar-panel {
  background: var(--color-ivory-card);
  border: 1px solid var(--color-ivory-border);
  border-radius: var(--radius-lg);
  padding: 2.2rem;
  box-shadow: 0 10px 30px rgba(37, 34, 31, 0.03);
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.6rem;
  padding-bottom: 0.8rem;
  border-bottom: 1px solid var(--color-border);
}

.panel-header h4 {
  font-family: var(--font-serif);
  font-size: 1.35rem;
  font-weight: 700;
  color: var(--color-charcoal);
}

.panel-header .badge-tag {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  letter-spacing: 0.1em;
  padding: 0.25rem 0.6rem;
  background-color: var(--color-burgundy-soft);
  color: var(--color-burgundy);
  border-radius: var(--radius-full);
  font-weight: 700;
}

.edu-timeline {
  display: flex;
  flex-direction: column;
  gap: 1.6rem;
}

.edu-item {
  position: relative;
  padding-left: 1.6rem;
  border-left: 2px solid var(--color-border-burgundy);
}

.edu-item::before {
  content: '';
  position: absolute;
  top: 4px;
  left: -6px;
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background-color: var(--color-burgundy);
  border: 2px solid var(--color-ivory);
}

.edu-date {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  letter-spacing: 0.08em;
  color: var(--color-burgundy);
  font-weight: 700;
}

.edu-degree {
  font-family: var(--font-sans);
  font-size: 0.98rem;
  font-weight: 700;
  color: var(--color-charcoal);
  margin: 0.2rem 0;
}

.edu-inst {
  font-family: var(--font-sans);
  font-size: 0.85rem;
  color: var(--color-charcoal-muted);
}

.edu-scores {
  display: flex;
  gap: 0.6rem;
  margin-top: 0.5rem;
}

.score-badge {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  padding: 0.2rem 0.55rem;
  background-color: var(--color-ivory-warm);
  border-radius: var(--radius-sm);
  color: var(--color-charcoal);
  font-weight: 600;
}

.score-badge.highlight {
  background-color: var(--color-burgundy);
  color: var(--color-ivory);
}

.skills-category-group {
  margin-bottom: 1.4rem;
}

.skills-category-group:last-child {
  margin-bottom: 0;
}

.skill-cat-title {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-charcoal-muted);
  margin-bottom: 0.6rem;
}

.skill-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 0.45rem;
}

.skill-chip {
  padding: 0.35rem 0.75rem;
  background-color: var(--color-ivory-warm);
  border-radius: var(--radius-sm);
  font-family: var(--font-sans);
  font-size: 0.8rem;
  font-weight: 500;
  color: var(--color-charcoal);
  transition: all 0.2s ease;
}

.skill-chip:hover {
  background-color: var(--color-burgundy);
  color: var(--color-ivory);
}

.skill-chip.cert {
  background-color: var(--color-burgundy-soft);
  color: var(--color-burgundy);
  font-weight: 600;
  border: 1px solid var(--color-border-burgundy);
}

/* ==========================================================================
   SECTION 3: PROJECTS (Meet Vora Style)
   Open in new page, clean action buttons without "↗ Opens in new page" hint
   ========================================================================== */
.projects-section {
  background-color: var(--color-ivory);
  border-bottom: 1px solid var(--color-border);
}

.projects-editorial-list {
  display: flex;
  flex-direction: column;
  gap: 4rem;
}

.project-feature-card {
  display: grid;
  grid-template-columns: 1.1fr 1fr;
  gap: 3.5rem;
  align-items: center;
  background-color: var(--color-ivory-card);
  border: 1px solid var(--color-ivory-border);
  border-radius: var(--radius-lg);
  padding: 3rem;
  box-shadow: 0 15px 40px rgba(37, 34, 31, 0.04);
  transition: transform 0.4s var(--ease-out-expo), box-shadow 0.4s var(--ease-out-expo), border-color 0.3s ease;
  position: relative;
  overflow: hidden;
}

.project-feature-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 22px 50px rgba(125, 38, 58, 0.1);
  border-color: var(--color-border-burgundy);
}

.project-visual-slot {
  position: relative;
  border-radius: var(--radius-md);
  overflow: hidden;
  background-color: var(--color-charcoal);
  aspect-ratio: 16 / 9.5;
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.12);
}

.project-visual-slot img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.7s var(--ease-out-expo);
}

.project-feature-card:hover .project-visual-slot img {
  transform: scale(1.04);
}

.project-visual-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 40%, rgba(37, 34, 31, 0.6) 100%);
}

.project-index-pill {
  position: absolute;
  top: 1.2rem;
  left: 1.2rem;
  padding: 0.35rem 0.85rem;
  background-color: rgba(37, 34, 31, 0.85);
  backdrop-filter: blur(8px);
  color: var(--color-ivory);
  font-family: var(--font-mono);
  font-size: 0.72rem;
  font-weight: 700;
  border-radius: var(--radius-full);
}

.project-details-slot {
  display: flex;
  flex-direction: column;
}

.project-meta-line {
  display: flex;
  align-items: center;
  gap: 1rem;
  margin-bottom: 0.8rem;
}

.project-category {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--color-burgundy);
  font-weight: 700;
}

.project-badge-tag {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  padding: 0.2rem 0.6rem;
  background-color: var(--color-ivory-warm);
  border-radius: var(--radius-sm);
  color: var(--color-charcoal-muted);
}

.project-title {
  font-family: var(--font-serif);
  font-size: clamp(1.8rem, 2.5vw, 2.4rem);
  font-weight: 700;
  line-height: 1.15;
  color: var(--color-charcoal);
  margin-bottom: 1.1rem;
}

.project-description {
  font-family: var(--font-sans);
  font-size: 1rem;
  line-height: 1.7;
  color: var(--color-charcoal-muted);
  margin-bottom: 1.6rem;
}

.tech-stack-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-bottom: 2rem;
}

.tech-tag {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  padding: 0.3rem 0.7rem;
  background-color: var(--color-ivory-warm);
  color: var(--color-charcoal);
  border-radius: var(--radius-full);
  border: 1px solid var(--color-border);
}

.btn-open-project {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  padding: 0.85rem 1.8rem;
  background-color: var(--color-burgundy);
  color: var(--color-ivory);
  font-family: var(--font-sans);
  font-size: 0.88rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  border-radius: var(--radius-full);
  box-shadow: 0 4px 14px var(--color-burgundy-soft);
  transition: all 0.3s var(--ease-out-expo);
  width: fit-content;
}

.btn-open-project:hover {
  background-color: var(--color-burgundy-dark);
  transform: translateX(4px);
  box-shadow: 0 8px 20px var(--color-burgundy-glow);
}

.btn-open-project svg {
  transition: transform 0.3s ease;
}

.btn-open-project:hover svg {
  transform: translate(3px, -3px);
}

/* ==========================================================================
   SECTION 4: NEW — VISUAL CRAFT & EXPLORATIONS (Canva & Figma Showcase)
   ========================================================================== */
.creative-works-section {
  background-color: var(--color-ivory-surface);
  border-bottom: 1px solid var(--color-border);
}

.creative-tabs-bar {
  display: flex;
  gap: 0.8rem;
  flex-wrap: wrap;
  margin-bottom: 3rem;
}

.creative-tab-btn {
  padding: 0.55rem 1.4rem;
  background-color: var(--color-ivory-card);
  border: 1px solid var(--color-ivory-border);
  border-radius: var(--radius-full);
  font-family: var(--font-sans);
  font-size: 0.84rem;
  font-weight: 600;
  color: var(--color-charcoal-muted);
  transition: all 0.25s ease;
}

.creative-tab-btn:hover, .creative-tab-btn.active {
  background-color: var(--color-burgundy);
  color: var(--color-ivory);
  border-color: var(--color-burgundy);
}

.creative-masonry-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 2rem;
}

.creative-card {
  background: var(--color-ivory-card);
  border: 1px solid var(--color-ivory-border);
  border-radius: var(--radius-md);
  overflow: hidden;
  box-shadow: 0 10px 25px rgba(37, 34, 31, 0.04);
  transition: transform 0.35s var(--ease-out-expo), box-shadow 0.35s var(--ease-out-expo);
  cursor: pointer;
  display: flex;
  flex-direction: column;
}

.creative-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 18px 40px rgba(125, 38, 58, 0.12);
  border-color: var(--color-border-burgundy);
}

.creative-thumb-wrap {
  width: 100%;
  aspect-ratio: 4 / 3.3;
  overflow: hidden;
  background-color: var(--color-ivory-warm);
  position: relative;
}

.creative-thumb-wrap img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s var(--ease-out-expo);
}

.creative-card:hover .creative-thumb-wrap img {
  transform: scale(1.06);
}

.creative-tool-tag {
  position: absolute;
  top: 1rem;
  right: 1rem;
  padding: 0.25rem 0.65rem;
  background: rgba(37, 34, 31, 0.85);
  backdrop-filter: blur(6px);
  color: var(--color-ivory);
  font-family: var(--font-mono);
  font-size: 0.68rem;
  font-weight: 700;
  border-radius: var(--radius-full);
}

.creative-info-body {
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  flex-grow: 1;
}

.creative-category {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-burgundy);
  font-weight: 700;
  margin-bottom: 0.4rem;
}

.creative-title {
  font-family: var(--font-serif);
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--color-charcoal);
  line-height: 1.3;
  margin-bottom: 0.5rem;
}

.creative-desc {
  font-family: var(--font-sans);
  font-size: 0.88rem;
  color: var(--color-charcoal-muted);
  line-height: 1.5;
  margin-bottom: 1.2rem;
}

.creative-footer-link {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  font-family: var(--font-mono);
  font-size: 0.74rem;
  font-weight: 700;
  color: var(--color-burgundy);
}

/* Lightbox Modal */
#creative-modal {
  position: fixed;
  inset: 0;
  z-index: 10001;
  background: rgba(37, 34, 31, 0.9);
  backdrop-filter: blur(10px);
  display: none;
  align-items: center;
  justify-content: center;
  padding: 2rem;
}

.modal-content-frame {
  max-width: 900px;
  max-height: 90vh;
  background: var(--color-ivory);
  border-radius: var(--radius-md);
  overflow: hidden;
  position: relative;
  box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6);
  display: flex;
  flex-direction: column;
}

.modal-close-btn {
  position: absolute;
  top: 1rem;
  right: 1rem;
  width: 36px;
  height: 36px;
  background: var(--color-charcoal);
  color: var(--color-ivory);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.2rem;
  z-index: 10;
  cursor: pointer;
}

.modal-image-display {
  max-height: 65vh;
  object-fit: contain;
  width: 100%;
  background: #000;
}

.modal-caption-bar {
  padding: 1.5rem 2rem;
}

/* ==========================================================================
   SECTION 5: WORK, INTERNSHIPS & ACHIEVEMENTS (Meet Vora Orbit UI)
   Label "Tactile UI Experience" removed; Drag hints removed
   ========================================================================== */
.tactile-section {
  background-color: var(--color-ivory);
  border-bottom: 1px solid var(--color-border);
  position: relative;
  overflow: hidden;
}

.tactile-orbit-showcase {
  background: var(--color-ivory-card);
  border: 1px solid var(--color-ivory-border);
  border-radius: var(--radius-lg);
  padding: 3.5rem 2.5rem;
  margin-bottom: 4.5rem;
  box-shadow: 0 15px 40px rgba(37, 34, 31, 0.04);
}

.orbit-controls-header {
  margin-bottom: 2rem;
}

.orbit-title-group h3 {
  font-family: var(--font-serif);
  font-size: 2.1rem;
  font-weight: 700;
  color: var(--color-charcoal);
}

.orbit-arena {
  position: relative;
  width: min(640px, 90vw);
  height: min(640px, 90vw);
  margin: 1.5rem auto 2.5rem auto;
  border-radius: 50%;
  border: 1px dashed var(--color-border-burgundy);
  display: flex;
  align-items: center;
  justify-content: center;
  user-select: none;
}

.orbit-center-core {
  width: 160px;
  height: 160px;
  border-radius: 50%;
  background: radial-gradient(circle, var(--color-burgundy), var(--color-burgundy-dark));
  color: var(--color-ivory);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 1.5rem;
  z-index: 10;
  box-shadow: 0 12px 30px var(--color-burgundy-glow);
  cursor: grab;
  transition: transform 0.3s var(--ease-out-expo);
}

.orbit-center-core:active {
  cursor: grabbing;
  transform: scale(0.96);
}

.core-label {
  font-family: var(--font-display);
  font-size: 1.05rem;
  font-weight: 800;
  letter-spacing: 0.06em;
}

.core-sub {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-ivory-warm);
  margin-top: 0.3rem;
}

.core-counter {
  font-family: var(--font-mono);
  font-size: 0.82rem;
  font-weight: 700;
  background: rgba(247, 243, 235, 0.2);
  padding: 0.15rem 0.5rem;
  border-radius: var(--radius-full);
  margin-top: 0.5rem;
}

.orbit-nodes-track {
  position: absolute;
  inset: 0;
  border-radius: 50%;
}

.tactile-node {
  position: absolute;
  top: 50%;
  left: 50%;
  transform-origin: center center;
  cursor: pointer;
  transition: transform 0.3s var(--ease-out-expo);
}

.node-pill {
  background-color: var(--color-ivory);
  border: 1px solid var(--color-ivory-border);
  padding: 0.6rem 1.1rem;
  border-radius: var(--radius-full);
  display: flex;
  align-items: center;
  gap: 0.6rem;
  box-shadow: 0 6px 18px rgba(37, 34, 31, 0.06);
  white-space: nowrap;
  transition: all 0.25s ease;
}

.tactile-node:hover .node-pill, .tactile-node.active .node-pill {
  background-color: var(--color-burgundy);
  color: var(--color-ivory);
  border-color: var(--color-burgundy);
  transform: scale(1.1);
  box-shadow: 0 10px 25px var(--color-burgundy-glow);
}

.node-icon {
  width: 24px;
  height: 24px;
  border-radius: 50%;
  background-color: var(--color-ivory-warm);
  color: var(--color-burgundy);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.75rem;
  font-weight: 700;
}

.tactile-node:hover .node-icon, .tactile-node.active .node-icon {
  background-color: var(--color-ivory);
  color: var(--color-burgundy);
}

.node-text {
  font-family: var(--font-sans);
  font-size: 0.8rem;
  font-weight: 600;
}

.orbit-detail-banner {
  background: var(--color-ivory-surface);
  border: 1px solid var(--color-border-burgundy);
  border-radius: var(--radius-md);
  padding: 1.8rem 2.2rem;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 1.5rem;
}

.orbit-detail-info h4 {
  font-family: var(--font-serif);
  font-size: 1.4rem;
  font-weight: 700;
  color: var(--color-charcoal);
}

.orbit-detail-info p {
  font-family: var(--font-sans);
  font-size: 0.95rem;
  color: var(--color-charcoal-muted);
  margin-top: 0.3rem;
}

.orbit-magic-badge {
  padding: 0.5rem 1rem;
  background-color: var(--color-burgundy);
  color: var(--color-ivory);
  border-radius: var(--radius-sm);
  font-family: var(--font-mono);
  font-size: 0.72rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  max-width: 320px;
  line-height: 1.4;
}

/* Achievements */
.achievements-grid-wrapper {
  margin-top: 2rem;
}

.achievements-filter-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 0.6rem;
  margin-bottom: 2.5rem;
}

.filter-btn {
  padding: 0.5rem 1.2rem;
  background-color: var(--color-ivory-card);
  border: 1px solid var(--color-ivory-border);
  border-radius: var(--radius-full);
  font-family: var(--font-sans);
  font-size: 0.82rem;
  font-weight: 600;
  color: var(--color-charcoal-muted);
  transition: all 0.25s ease;
}

.filter-btn:hover, .filter-btn.active {
  background-color: var(--color-burgundy);
  color: var(--color-ivory);
  border-color: var(--color-burgundy);
}

.achievements-cards-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
  gap: 1.8rem;
}

.achievement-card {
  background: var(--color-ivory-card);
  border: 1px solid var(--color-ivory-border);
  border-radius: var(--radius-md);
  padding: 2rem;
  box-shadow: 0 8px 24px rgba(37, 34, 31, 0.03);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  transition: all 0.3s var(--ease-out-expo);
  position: relative;
  overflow: hidden;
}

.achievement-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 4px;
  height: 100%;
  background-color: var(--color-burgundy);
  opacity: 0;
  transition: opacity 0.25s ease;
}

.achievement-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 16px 36px rgba(125, 38, 58, 0.08);
  border-color: var(--color-border-burgundy);
}

.achievement-card:hover::before {
  opacity: 1;
}

.achievement-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 1rem;
}

.achievement-cat {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-burgundy);
  font-weight: 700;
}

.achievement-rank-pill {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  padding: 0.2rem 0.55rem;
  background-color: var(--color-ivory-warm);
  border-radius: var(--radius-full);
  font-weight: 700;
  color: var(--color-charcoal);
}

.achievement-card h4 {
  font-family: var(--font-serif);
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--color-charcoal);
  line-height: 1.3;
  margin-bottom: 0.8rem;
}

.achievement-card p {
  font-family: var(--font-sans);
  font-size: 0.88rem;
  color: var(--color-charcoal-muted);
  line-height: 1.6;
}

.achievement-footer {
  margin-top: 1.5rem;
  padding-top: 1rem;
  border-top: 1px solid var(--color-border);
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-family: var(--font-mono);
  font-size: 0.72rem;
  color: var(--color-charcoal-light);
}

/* ==========================================================================
   SECTION 6: CONTACT ME (Meet Vora Style + Thibaut Crépelle Keyboard)
   Warm Ivory & Burgundy palette, massive friendly typography, copy email pill
   ========================================================================== */
.contact-section {
  background-color: var(--color-ivory-surface);
  color: var(--color-charcoal);
  position: relative;
  overflow: hidden;
  border-top: 1px solid var(--color-border);
  padding-bottom: 5rem;
}

/* Meet Vora Iconic Giant Contact Headline & Magnetic Email Box */
.meetvora-contact-card {
  background: var(--color-ivory-card);
  border: 1px solid var(--color-ivory-border);
  border-radius: var(--radius-lg);
  padding: 4rem 3.5rem;
  margin-bottom: 3.5rem;
  box-shadow: 0 20px 50px rgba(37, 34, 31, 0.04);
  text-align: center;
  position: relative;
}

.meetvora-contact-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0.4rem 1rem;
  background-color: var(--color-ivory-warm);
  border-radius: var(--radius-full);
  font-family: var(--font-mono);
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--color-charcoal);
  margin-bottom: 1.8rem;
}

.meetvora-contact-headline {
  font-family: var(--font-serif);
  font-size: clamp(2.4rem, 5.5vw, 4.8rem);
  font-weight: 700;
  line-height: 1.05;
  color: var(--color-charcoal);
  margin-bottom: 1.5rem;
}

.meetvora-contact-headline span {
  font-style: italic;
  font-weight: 400;
  color: var(--color-burgundy);
}

.meetvora-contact-sub {
  font-size: 1.15rem;
  color: var(--color-charcoal-muted);
  max-width: 620px;
  margin: 0 auto 2.5rem auto;
}

.meetvora-email-action-row {
  display: flex;
  justify-content: center;
  gap: 1.2rem;
  flex-wrap: wrap;
}

.btn-meetvora-email {
  display: inline-flex;
  align-items: center;
  gap: 0.8rem;
  padding: 1rem 2.4rem;
  background-color: var(--color-burgundy);
  color: var(--color-ivory);
  font-family: var(--font-sans);
  font-size: 1rem;
  font-weight: 600;
  border-radius: var(--radius-full);
  box-shadow: 0 6px 20px var(--color-burgundy-soft);
  transition: all 0.3s var(--ease-out-expo);
}

.btn-meetvora-email:hover {
  background-color: var(--color-burgundy-dark);
  transform: translateY(-3px);
  box-shadow: 0 10px 25px var(--color-burgundy-glow);
}

.btn-copy-email {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  padding: 1rem 1.8rem;
  background-color: var(--color-ivory-warm);
  border: 1px solid var(--color-ivory-border);
  color: var(--color-charcoal);
  font-family: var(--font-mono);
  font-size: 0.85rem;
  font-weight: 700;
  border-radius: var(--radius-full);
  transition: all 0.25s ease;
}

.btn-copy-email:hover {
  border-color: var(--color-burgundy);
  color: var(--color-burgundy);
}

/* Copy notification toast */
#copy-toast {
  position: fixed;
  bottom: 2rem;
  left: 50%;
  transform: translateX(-50%) translateY(100px);
  background: var(--color-burgundy);
  color: var(--color-ivory);
  padding: 0.75rem 1.8rem;
  border-radius: var(--radius-full);
  font-family: var(--font-mono);
  font-size: 0.82rem;
  font-weight: 700;
  box-shadow: 0 10px 30px var(--color-burgundy-glow);
  z-index: 10002;
  transition: transform 0.4s var(--ease-out-expo);
  pointer-events: none;
}

#copy-toast.show {
  transform: translateX(-50%) translateY(0);
}

/* Thibaut Crépelle Mechanical Keyboard in Sleek Black Aesthetic */
.keyboard-console-wrapper {
  max-width: 1040px;
  margin: 0 auto;
  background: #141312;
  border: 1px solid rgba(247, 243, 235, 0.12);
  border-radius: var(--radius-lg);
  padding: 2.8rem;
  box-shadow: 0 30px 70px rgba(0, 0, 0, 0.45), inset 0 1px 2px rgba(255, 255, 255, 0.05);
}

.keyboard-display-screen {
  background: #0c0b0a;
  border: 1px solid rgba(247, 243, 235, 0.1);
  border-radius: var(--radius-md);
  padding: 1.6rem 2rem;
  margin-bottom: 2.5rem;
  position: relative;
  box-shadow: inset 0 2px 10px rgba(0, 0, 0, 0.6);
}

.screen-header-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-family: var(--font-mono);
  font-size: 0.72rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--color-burgundy-light);
  margin-bottom: 0.8rem;
  border-bottom: 1px solid rgba(247, 243, 235, 0.08);
  padding-bottom: 0.5rem;
}

.screen-leds {
  display: flex;
  align-items: center;
  gap: 8px;
}

.led-indicator {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: rgba(247, 243, 235, 0.15);
}

.led-indicator.active {
  background-color: #2e8b57;
  box-shadow: 0 0 8px #2e8b57;
}

.led-indicator.burgundy {
  background-color: var(--color-burgundy-light);
  box-shadow: 0 0 8px var(--color-burgundy-light);
}

.terminal-type-output {
  font-family: var(--font-mono);
  font-size: clamp(1rem, 1.8vw, 1.35rem);
  color: var(--color-ivory);
  min-height: 2.5rem;
  display: flex;
  align-items: center;
  word-break: break-all;
}

.terminal-cursor-blink {
  display: inline-block;
  width: 10px;
  height: 1.2em;
  background-color: var(--color-burgundy-light);
  margin-left: 6px;
  animation: blink 1s step-end infinite;
}

@keyframes blink {
  50% { opacity: 0; }
}

.terminal-action-buttons {
  display: flex;
  gap: 1rem;
  margin-top: 1rem;
}

.btn-terminal {
  padding: 0.45rem 1rem;
  font-family: var(--font-mono);
  font-size: 0.75rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  border-radius: var(--radius-sm);
  transition: all 0.2s ease;
}

.btn-terminal-clear {
  background: rgba(247, 243, 235, 0.08);
  color: var(--color-ivory);
  border: 1px solid rgba(247, 243, 235, 0.12);
}

.btn-terminal-clear:hover {
  background: rgba(247, 243, 235, 0.15);
}

.btn-terminal-send {
  background: var(--color-burgundy);
  color: var(--color-ivory);
}

.btn-terminal-send:hover {
  background: var(--color-burgundy-light);
  box-shadow: 0 0 15px var(--color-burgundy-glow);
}

.keyboard-chassis {
  display: flex;
  flex-direction: column;
  gap: 10px;
  background: #0d0c0b;
  padding: 1.5rem;
  border-radius: var(--radius-md);
  border: 1px solid rgba(247, 243, 235, 0.08);
  box-shadow: inset 0 2px 10px rgba(0, 0, 0, 0.6);
}

.keyboard-row {
  display: flex;
  gap: 8px;
  justify-content: center;
}

/* Tactile Keycaps in Matte Dark Charcoal / Black */
.keycap {
  position: relative;
  height: 52px;
  min-width: 48px;
  padding: 0 10px;
  background: linear-gradient(180deg, #2c2926 0%, #1e1b19 100%);
  border-radius: 6px;
  border-top: 1px solid rgba(255, 255, 255, 0.12);
  border-bottom: 4px solid #100f0e;
  box-shadow: 0 4px 6px rgba(0, 0, 0, 0.35);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: var(--color-ivory);
  font-family: var(--font-mono);
  font-size: 0.85rem;
  font-weight: 700;
  user-select: none;
  transition: transform 0.05s ease, border-bottom-width 0.05s ease, box-shadow 0.05s ease;
}

.keycap:hover {
  background: linear-gradient(180deg, #383430 0%, #262320 100%);
}

.keycap:active, .keycap.pressed {
  transform: translateY(3px);
  border-bottom-width: 1px;
  box-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
}

.keycap .sub-label {
  font-size: 0.55rem;
  opacity: 0.55;
  margin-top: 2px;
}

.keycap.key-special {
  background: linear-gradient(180deg, var(--color-burgundy-light) 0%, var(--color-burgundy) 100%);
  border-top: 1px solid rgba(255, 255, 255, 0.25);
  border-bottom-color: var(--color-burgundy-dark);
  color: var(--color-ivory);
  font-size: 0.78rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  min-width: 80px;
}

.keycap.key-special:hover {
  background: linear-gradient(180deg, #A8344D 0%, var(--color-burgundy-light) 100%);
}

.keycap.key-space {
  flex-grow: 1;
  max-width: 320px;
}

.keycap.key-wide {
  min-width: 74px;
}

.direct-contact-ribbon {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 1.2rem;
  margin-top: 2.5rem;
}

.contact-card-link {
  background: rgba(247, 243, 235, 0.04);
  border: 1px solid rgba(247, 243, 235, 0.09);
  border-radius: var(--radius-md);
  padding: 1.4rem 1.6rem;
  display: flex;
  align-items: center;
  gap: 1.2rem;
  transition: all 0.3s var(--ease-out-expo);
}

.contact-card-link:hover {
  background: rgba(125, 38, 58, 0.15);
  border-color: var(--color-burgundy-light);
  transform: translateY(-3px);
}

.contact-icon-box {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: var(--color-burgundy);
  color: var(--color-ivory);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.1rem;
}

.contact-card-text {
  display: flex;
  flex-direction: column;
}

.contact-card-text .contact-type {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-burgundy-light);
}

.contact-card-text .contact-handle {
  font-family: var(--font-sans);
  font-size: 0.88rem;
  font-weight: 600;
  color: var(--color-ivory);
}

/* ==========================================================================
   Footer
   ========================================================================== */
.site-footer {
  background-color: var(--color-charcoal);
  color: var(--color-ivory);
  padding: 4rem 3rem 2rem 3rem;
}

.footer-top {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding-bottom: 3rem;
  border-bottom: 1px solid rgba(247, 243, 235, 0.08);
}

.footer-brand h3 {
  font-family: var(--font-serif);
  font-size: 2.2rem;
  font-weight: 700;
}

.footer-brand p {
  font-family: var(--font-mono);
  font-size: 0.8rem;
  color: var(--color-burgundy-light);
  margin-top: 0.4rem;
}

.footer-live-clock {
  text-align: right;
  font-family: var(--font-mono);
}

.clock-val {
  font-size: 1.8rem;
  font-weight: 700;
  color: var(--color-ivory);
}

.clock-label {
  font-size: 0.72rem;
  color: rgba(247, 243, 235, 0.5);
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.footer-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 2rem;
  font-family: var(--font-sans);
  font-size: 0.8rem;
  color: rgba(247, 243, 235, 0.6);
}

.footer-bottom strong {
  color: var(--color-ivory);
}

/* ==========================================================================
   Responsive Adaptations
   ========================================================================== */
@media (max-width: 1024px) {
  .site-header {
    padding: 1.2rem 2rem;
  }
  .nav-links {
    display: none;
  }
  .hero-section {
    padding: 8rem 2rem 3rem 2rem;
  }
  .hero-statement-grid {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  .about-grid {
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  .project-feature-card {
    grid-template-columns: 1fr;
    padding: 2rem;
    gap: 2rem;
  }
}

@media (max-width: 768px) {
  .section-container {
    padding: 5rem 1.5rem;
  }
  .hero-title-main {
    font-size: 2.6rem;
  }
  .orbit-arena {
    width: 330px;
    height: 330px;
  }
  .orbit-center-core {
    width: 120px;
    height: 120px;
  }
  .core-label {
    font-size: 0.9rem;
  }
  .keycap {
    min-width: 28px;
    height: 44px;
    padding: 0 4px;
    font-size: 0.7rem;
  }
  .keycap.key-special {
    min-width: 48px;
    font-size: 0.62rem;
  }
}
