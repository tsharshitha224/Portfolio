  <!-- ======================================================================
       SECTION 3: SELECTED PROJECTS (Dedicated Standalone Case Studies)
       ====================================================================== -->
  <section id="projects" class="projects-section">
    <div class="section-container">
      <div class="section-editorial-header">
        <span class="section-label">Engineering Case Studies</span>
        <h2 class="section-title">Selected <span>Projects</span></h2>
        <p class="section-subhead">
          Each project features an in-depth standalone breakdown. Click to explore architecture and benchmarks.
        </p>
      </div>

      <div class="projects-editorial-list">
        <!-- Project 1: Carbon Trading -->
        <article class="project-feature-card" data-cursor="VIEW">
          <div class="project-visual-slot">
            <span class="project-index-pill">01 // BLOCKCHAIN</span>
            <img src="assets/images/carbon-trading.jpg" alt="Enhanced DLT Carbon Trading Platform Dashboard" loading="lazy">
            <div class="project-visual-overlay"></div>
          </div>

          <div class="project-details-slot">
            <div class="project-meta-line">
              <span class="project-category">Decentralized Finance</span>
              <span class="project-badge-tag">DLT & Smart Contracts</span>
            </div>

            <h3 class="project-title">An Enhanced DLT - Based Carbon Trading Platform</h3>

            <p class="project-description">
              A decentralized marketplace leveraging Distributed Ledger Technology (DLT) and Ethereum Smart Contracts to enable transparent, secure, and automated carbon credit trading without predatory intermediaries.
            </p>

            <div class="tech-stack-wrap">
              <span class="tech-tag">Ethereum</span>
              <span class="tech-tag">Solidity</span>
              <span class="tech-tag">Node.js</span>
              <span class="tech-tag">Express.js</span>
              <span class="tech-tag">HTML5 / CSS3</span>
              <span class="tech-tag">JavaScript (ES6)</span>
              <span class="tech-tag">MongoDB</span>
            </div>

            <a href="projects/carbon-trading.html" target="_blank" rel="noopener noreferrer" class="btn-open-project" data-magnetic>
              <span>Open Case Study</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
            </a>
          </div>
        </article>

        <!-- Project 2: SIH 2023 Surveillance -->
        <article class="project-feature-card" data-cursor="VIEW">
          <div class="project-visual-slot">
            <span class="project-index-pill">02 // COMPUTER VISION</span>
            <img src="assets/images/smart-surveillance.jpg" alt="SIH 2023 Smart CCTV Surveillance Dashboard" loading="lazy">
            <div class="project-visual-overlay"></div>
          </div>

          <div class="project-details-slot">
            <div class="project-meta-line">
              <span class="project-category">Smart India Hackathon 2023</span>
              <span class="project-badge-tag">AI / ML Surveillance</span>
            </div>

            <h3 class="project-title">AI/ML CCTV Network for Crowd Management & Crime Prevention</h3>

            <p class="project-description">
              Developed an AI/ML-powered solution utilizing existing municipal CCTV infrastructure to enable real-time crowd density tracking, crime prevention, and workforce monitoring as an integrated smart surveillance system.
            </p>

            <div class="tech-stack-wrap">
              <span class="tech-tag">TensorFlow</span>
              <span class="tech-tag">PyTorch</span>
              <span class="tech-tag">YOLO</span>
              <span class="tech-tag">CNN</span>
              <span class="tech-tag">Python</span>
              <span class="tech-tag">Flask / Django</span>
              <span class="tech-tag">HTML5 / CSS3</span>
            </div>

            <a href="projects/smart-surveillance.html" target="_blank" rel="noopener noreferrer" class="btn-open-project" data-magnetic>
              <span>Open Case Study</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
            </a>
          </div>
        </article>

        <!-- Project 3: Citizen Fraud Shield -->
        <article class="project-feature-card" data-cursor="VIEW">
          <div class="project-visual-slot">
            <span class="project-index-pill">03 // GENERATIVE AI & RAG</span>
            <img src="assets/images/fraud-shield.jpg" alt="Citizen Fraud Shield RAG Chatbot Interface" loading="lazy">
            <div class="project-visual-overlay"></div>
          </div>

          <div class="project-details-slot">
            <div class="project-meta-line">
              <span class="project-category">Civic Cyber-Defense</span>
              <span class="project-badge-tag">RAG & LLM Reasoning</span>
            </div>

            <h3 class="project-title">Citizen Fraud Shield: Real-Time Scam Analysis Chatbot</h3>

            <p class="project-description">
              A high-precision RAG-based chatbot that analyzes citizen-reported scam calls, SMS, and phishing messages in real time, returning immediate risk scoring, threat type categorization, and safety action steps via Groq and ChromaDB.
            </p>

            <div class="tech-stack-wrap">
              <span class="tech-tag">FastAPI</span>
              <span class="tech-tag">Groq API (Llama 3.3)</span>
              <span class="tech-tag">ChromaDB</span>
              <span class="tech-tag">Sentence-Transformers</span>
              <span class="tech-tag">Python</span>
              <span class="tech-tag">HTML5 / JavaScript</span>
            </div>

            <a href="projects/citizen-fraud-shield.html" target="_blank" rel="noopener noreferrer" class="btn-open-project" data-magnetic>
              <span>Open Case Study</span>
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M7 17L17 7M17 7H7M17 7V17"/></svg>
            </a>
          </div>
        </article>
      </div>
    </div>
  </section>

