  <!-- ======================================================================
       SECTION 2: ABOUT ME (Meet Vora Inspired)
       ====================================================================== -->
  <section id="about" class="about-section">
    <div class="section-container">
      <div class="section-editorial-header">
        <span class="section-label">Identity & Background</span>
        <h2 class="section-title">About <span>Me</span></h2>
        <p class="section-subhead">
          Bridging the structural discipline of Computer and Communication Engineering with tactile creative development.
        </p>
      </div>

      <div class="about-grid">
        <!-- Main Bio Card -->
        <div class="about-narrative-card" data-cursor="STORY">
          <div class="author-header-badge">
            <div class="author-avatar-seal">TH</div>
            <div class="author-title-group">
              <h3>T S HARSHITHA</h3>
              <p>Engineer · Product Designer · Researcher</p>
            </div>
          </div>

          <p class="about-bio-text">
            Hello! I'm <strong>Harshitha Suresh</strong>, currently in my pre-final year of <strong>Computer and Communication Engineering</strong> at Sri Sairam Institute of Technology, Chennai.
          </p>

          <div class="about-bio-quote">
            "I believe code should not merely execute; it should communicate with poise and clarity. True engineering is where algorithmic rigor and tactile human emotion intersect."
          </div>

          <p class="about-bio-text">
            On the technical side, I build distributed smart contracts (Ethereum/Solidity), real-time computer vision networks (YOLO/PyTorch), and Retrieval-Augmented Generation systems (FastAPI/Groq/ChromaDB). On the creative side, I craft brand identities, vector illustrations, and interactive UI systems in Figma and Canva, while leading marketing initiatives at TEDx and organizing departmental IEEE symposiums.
          </p>

          <!-- Polyglot Languages Bar -->
          <div class="polyglot-block">
            <h4 class="polyglot-title">Languages Spoken & Written</h4>
            <div class="polyglot-pills">
              <span class="lang-pill" data-cursor="LANG">English</span>
              <span class="lang-pill" data-cursor="LANG">Tamil</span>
              <span class="lang-pill" data-cursor="LANG">Telugu</span>
              <span class="lang-pill" data-cursor="LANG">Hindi</span>
              <span class="lang-pill" data-cursor="LANG">Japanese (日本語)</span>
              <span class="lang-pill" data-cursor="LANG">Sourashtra</span>
            </div>
          </div>
        </div>

        <!-- Sidebar: Education & Skills -->
        <div class="about-sidebar-column">
          <!-- Education Timeline Panel -->
          <div class="sidebar-panel" data-cursor="ACADEMICS">
            <div class="panel-header">
              <h4>Education</h4>
              <span class="badge-tag">RECORD</span>
            </div>

            <div class="edu-timeline">
              <!-- College -->
              <div class="edu-item">
                <span class="edu-date">OCT 2022 — MAY 2026</span>
                <h5 class="edu-degree">B.E. Computer & Communication Engineering</h5>
                <p class="edu-inst">Sri Sairam Institute of Technology, Chennai, Tamil Nadu</p>
                <div class="edu-scores">
                  <span class="score-badge highlight">Current GPA: 9.70</span>
                  <span class="score-badge">CGPA: 8.62</span>
                </div>
              </div>

              <!-- High School HSC -->
              <div class="edu-item">
                <span class="edu-date">MAY 2021 — MAY 2022</span>
                <h5 class="edu-degree">Higher Secondary Certificate (Computer Science)</h5>
                <p class="edu-inst">Maharishi Vidya Mandir, Chennai, Tamil Nadu</p>
                <div class="edu-scores">
                  <span class="score-badge">GPA: 72.2%</span>
                </div>
              </div>

              <!-- School SSC -->
              <div class="edu-item">
                <span class="edu-date">MAY 2019 — MAY 2020</span>
                <h5 class="edu-degree">Secondary School Certificate (SSC)</h5>
                <p class="edu-inst">Maharishi Vidya Mandir, Chennai, Tamil Nadu</p>
                <div class="edu-scores">
                  <span class="score-badge highlight">GPA: 86.2%</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Knowledge Acquired Panel -->
          <div class="sidebar-panel" data-cursor="SKILLS">
            <div class="panel-header">
              <h4>Knowledge Acquired</h4>
              <span class="badge-tag">STACK</span>
            </div>

            <div class="skills-category-group">
              <h5 class="skill-cat-title">Full Stack & Web Development</h5>
              <div class="skill-chips">
                <span class="skill-chip">HTML5</span>
                <span class="skill-chip">CSS3</span>
                <span class="skill-chip">JavaScript (ES6+)</span>
